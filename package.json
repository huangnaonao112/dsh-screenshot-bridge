{
  "name": "dsh-screenshot-bridge",
  "version": "1.0.1",
  "description": "DeepSeek Harness 截图桥：全局快捷键或鼠标侧键截屏，并把图片发送到指定会话。",
  "type": "module",
  "license": "MIT",
  "author": "huangnaonao112",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangnaonao112/dsh-screenshot-bridge.git"
  },
  "homepage": "https://github.com/huangnaonao112/dsh-screenshot-bridge#readme",
  "bugs": {
    "url": "https://github.com/huangnaonao112/dsh-screenshot-bridge/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "screenshot",
    "screenshot-bridge",
    "windows"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "hotkey.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
